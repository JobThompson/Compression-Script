# Folder containing the source .mp4 / .mkv files to compress (required)
INPUT_DIR=/path/to/input/folder

# Folder where compressed files will be saved; created if missing (required)
OUTPUT_DIR=/path/to/output/folder

# Compression mode (default: lossy)
#   lossy    -> H.265 video at the CRF below + AAC audio (much smaller files)
#   lossless -> x265 lossless video + audio streams copied untouched (CPU only, no AVI)
COMPRESSION_MODE=lossy

# CRF (Constant Rate Factor) for H.265, 0-51. Lower = better quality, larger file.
# Recommended range: 24-30 (default: 28). Ignored when COMPRESSION_MODE=lossless.
CRF=28

# Maximum ffmpeg runtime per file, in seconds (default: 36000 = 10 hours).
# Set to 0 to disable the timeout (recommended for very large files).
TIMEOUT_SECONDS=36000

# Output container: source, mkv, mp4, avi (default: source)
#   source keeps each input file's original extension.
#   avi always uses Xvid video + MP3 audio and drops subtitles.
OUTPUT_FORMAT=source

# x265 speed/quality preset, used only when ENCODER_TYPE=cpu (default: medium).
# Faster presets finish sooner but produce larger files at the same CRF.
# Options: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow, placebo
ENCODER_PRESET=medium

# Video encoder backend for source/mkv/mp4 outputs (default: cpu)
#   cpu    -> libx265     (best compression, slowest)
#   nvidia -> hevc_nvenc  (NVIDIA GPUs)
#   intel  -> hevc_qsv    (Intel Quick Sync)
#   amd    -> hevc_amf    (AMD GPUs)
ENCODER_TYPE=cpu

# Re-encode files whose output already exists? (default: false)
# false lets you re-run the script to resume an interrupted batch.
OVERWRITE_EXISTING=false
